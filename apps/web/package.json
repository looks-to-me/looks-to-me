{
  "name": "@looks-to-me/app-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "wrangler types --env-interface CloudflareEnv && next typegen",
    "dev": "next dev",
    "dev:storybook": "storybook dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "build:storybook": "rimraf public/storybook && storybook build && mv storybook-static public/storybook && sed -i 's#<head>#<head>\\\\n<base href='\\/storybook\\/'>#' public/storybook/index.html",
    "build:app": "pnpm run build:storybook && pnpm run build:worker",
    "deploy": "opennextjs-cloudflare deploy",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint:code": "eslint .",
    "lint:type": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "13.13.0",
    "@looks-to-me/package-database": "workspace:*",
    "@looks-to-me/package-tiered-cache": "workspace:*",
    "@opennextjs/cloudflare": "1.18.0",
    "@paralleldrive/cuid2": "3.3.0",
    "@praha/vanilla-essence": "1.1.3",
    "@supabase/supabase-js": "2.100.1",
    "ahooks": "3.9.7",
    "client-only": "0.0.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "0.577.0",
    "modern-normalize": "3.0.1",
    "next": "15.5.14",
    "radix-ui": "1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "valibot": "1.3.1"
  },
  "devDependencies": {
    "@praha/eslint-config-definer": "2.0.2",
    "@praha/eslint-config-next": "4.0.14",
    "@praha/eslint-config-react": "4.0.12",
    "@sqlite.org/sqlite-wasm": "3.48.0-build4",
    "@storybook/addon-links": "10.3.3",
    "@storybook/addon-styling-webpack": "3.0.1",
    "@storybook/nextjs": "10.3.3",
    "@storybook/react": "10.3.3",
    "@supabase/ssr": "0.9.0",
    "@tsconfig/next": "2.0.6",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vanilla-extract/css": "1.18.0",
    "@vanilla-extract/css-utils": "0.1.6",
    "@vanilla-extract/next-plugin": "2.4.17",
    "@vanilla-extract/recipes": "0.5.7",
    "@vanilla-extract/vite-plugin": "5.1.4",
    "@vanilla-extract/webpack-plugin": "2.3.25",
    "@vitejs/plugin-react": "5.2.0",
    "better-sqlite3": "12.8.0",
    "css-loader": "7.1.4",
    "dotenv": "17.3.1",
    "eslint": "9.39.4",
    "mini-css-extract-plugin": "2.10.2",
    "miniflare": "4.20260317.3",
    "rimraf": "6.1.3",
    "storybook": "10.3.3",
    "style-loader": "4.0.0",
    "typescript": "5.9.3",
    "vercel": "48.12.1",
    "vitest": "4.1.2",
    "wrangler": "4.78.0"
  }
}
