{
  "name": "@looks-to-me/app-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "wrangler types --env-interface CloudflareEnv && next typegen && graphql-codegen --config codegen.ts",
    "dev": "next dev --webpack",
    "dev:storybook": "storybook dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "build:storybook": "rimraf public/storybook && storybook build && mv storybook-static public/storybook && sed -i 's#<head>#<head>\\\\n<base href='\\/storybook\\/'>#' public/storybook/index.html",
    "build:app": "pnpm run build:storybook && pnpm run build:worker",
    "deploy": "opennextjs-cloudflare deploy",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint:code": "eslint .",
    "lint:type": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@envelop/core": "5.5.1",
    "@graphql-tools/executor-http": "3.3.0",
    "@icons-pack/react-simple-icons": "13.13.0",
    "@looks-to-me/package-database": "workspace:*",
    "@looks-to-me/package-graphql": "workspace:*",
    "@looks-to-me/package-tiered-cache": "workspace:*",
    "@opennextjs/cloudflare": "1.20.1",
    "@paralleldrive/cuid2": "3.3.0",
    "@praha/byethrow": "0.12.0",
    "@praha/vanilla-essence": "1.1.3",
    "@supabase/supabase-js": "2.110.0",
    "ahooks": "3.9.7",
    "client-only": "0.0.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.2",
    "graphql": "16.12.0",
    "graphql-yoga": "5.21.2",
    "lucide-react": "1.23.0",
    "modern-normalize": "3.0.1",
    "next": "16.2.10",
    "radix-ui": "1.6.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "server-only": "0.0.1",
    "sonner": "2.0.7",
    "valibot": "1.4.2"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "6.1.0",
    "@graphql-tools/utils": "10.11.0",
    "@graphql-typed-document-node/core": "3.2.0",
    "@praha/eslint-config-definer": "2.0.2",
    "@praha/eslint-config-next": "4.0.14",
    "@praha/eslint-config-react": "4.0.12",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "@storybook/addon-links": "10.4.6",
    "@storybook/nextjs-vite": "10.4.6",
    "@supabase/ssr": "0.12.0",
    "@tsconfig/next": "2.0.6",
    "@types/node": "24.10.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vanilla-extract/css": "1.21.1",
    "@vanilla-extract/css-utils": "0.1.6",
    "@vanilla-extract/next-plugin": "2.5.2",
    "@vanilla-extract/recipes": "0.5.7",
    "@vanilla-extract/vite-plugin": "5.2.4",
    "@vitejs/plugin-react": "5.1.0",
    "better-sqlite3": "12.11.1",
    "dotenv": "17.4.2",
    "eslint": "9.39.4",
    "miniflare": "4.20260701.0",
    "rimraf": "6.1.3",
    "storybook": "10.4.6",
    "typescript": "5.9.3",
    "vercel": "54.20.1",
    "vite": "7.3.0",
    "vitest": "4.1.10",
    "wrangler": "4.107.0"
  }
}
