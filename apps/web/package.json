{
  "name": "@looks-to-me/app-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "wrangler types --include-runtime false",
    "dev": "next dev",
    "dev:storybook": "storybook dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "build:storybook": "rimraf public/storybook && storybook build && mv storybook-static public/storybook && sed -i 's#<head>#<head>\\\\n<base href='\\/storybook\\/'>#' public/storybook/index.html",
    "build:ci": "pnpm run build:storybook && pnpm run build:worker",
    "deploy": "pnpm run build:ci && opennextjs-cloudflare deploy",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint:code": "eslint .",
    "lint:type": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "12.9.0",
    "@looks-to-me/package-database": "workspace:*",
    "@looks-to-me/package-image-cache": "workspace:*",
    "@looks-to-me/package-ui-theme": "workspace:*",
    "@opennextjs/cloudflare": "1.3.1",
    "@paralleldrive/cuid2": "2.2.2",
    "@praha/vanilla-essence": "1.1.2",
    "@radix-ui/react-accessible-icon": "1.1.7",
    "@radix-ui/react-alert-dialog": "1.1.14",
