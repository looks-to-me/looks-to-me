{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "web",
  "workers_dev": false,
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "web"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "id",
      "database_name": "name"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "name"
    }
  ],
  "env": {
    "preview": {
      "name": "web-preview",
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "web-preview"
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_id": "id-preview",
          "database_name": "name-preview"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "name-preview"
        }
      ]
    }
  }
}
