{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "web",
  "workers_dev": false,
  "compatibility_date": "2025-10-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "web"
    },
    {
      "binding": "OVERLAY",
      "service": "overlay"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "id",
      "database_name": "name",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "bucket"
    },
    {
      "binding": "TIERED_CACHE",
      "bucket_name": "tiered-cache"
    }
  ],
  "observability": {
    "traces": {
      "enabled": true
    }
  }
}
