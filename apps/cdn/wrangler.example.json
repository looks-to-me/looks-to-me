{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cdn",
  "main": "src/index.ts",
  "workers_dev": false,
  "compatibility_date": "2025-10-01",
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "bucket"
    },
    {
      "binding": "TIERED_CACHE",
      "bucket_name": "tiered-cache"
    }
  ],
  "observability": {
    "traces": {
      "enabled": true
    }
  }
}
