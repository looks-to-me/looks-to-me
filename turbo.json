{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env",
    "**/.env.*local"
  ],
  "tasks": {
    "generate": {
      "outputs": [
        "worker-configuration.d.ts"
      ]
    },
    "build:ci": {
      "dependsOn": [
        "generate"
      ],
      "outputs": [
        ".next/**",
        "dist/**"
      ]
    },
    "test": {
      "dependsOn": [
        "generate"
      ]
    },
    "lint:code": {
      "dependsOn": [
        "generate"
      ]
    },
    "lint:type": {
      "dependsOn": [
        "generate"
      ]
    }
  }
}
