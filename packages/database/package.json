{
  "name": "@looks-to-me/package-database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.d.ts"
    },
    "./wasm": {
      "import": "./dist/wasm.js",
      "require": "./dist/wasm.d.ts"
    }
  },
  "scripts": {
    "build": "rslib build",
    "migrate:create": "drizzle-kit generate:sqlite",
    "migrate:apply": "wrangler d1 migrations apply production --local --config ../../apps/web/wrangler.json",
    "lint:code": "eslint",
    "lint:type": "tsc --pretty --noEmit"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.48.0-build4",
    "drizzle-orm": "0.45.1"
  },
  "devDependencies": {
    "@praha/eslint-config-definer": "2.0.2",
    "@rslib/core": "0.20.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "wrangler": "4.74.0"
  }
}
