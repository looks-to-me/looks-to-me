{
  "name": "@looks-to-me/package-database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./wasm": {
      "import": "./dist/wasm.js",
      "types": "./dist/wasm.d.ts"
    }
  },
  "scripts": {
    "build": "rslib build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "lint:code": "eslint",
    "lint:type": "tsc --pretty --noEmit",
    "migrate:create": "drizzle-kit generate:sqlite",
    "migrate:apply": "wrangler d1 migrations apply production --local --config ../../apps/web/wrangler.json"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260702.1",
    "@praha/eslint-config-definer": "2.0.2",
    "@rslib/core": "0.23.2",
    "@types/node": "24.10.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.107.0"
  }
}
